{
  "name": "hammer-monorepo",
  "version": "1.0.1",
  "description": "Monorepo for Hammer project",
  "packageManager": "pnpm@10.12.4",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "setup": "pnpm clean && pnpm install -w",
    "clean": "turbo run clean && rm -rf node_modules pnpm-lock.yaml .turbo",
    "clean:cache": "turbo run clean && rm -rf node_modules pnpm-lock.yaml .turbo node_modules/.cache tsconfig.tsbuildinfo",
    "typegen": "turbo run typegen",
    "dev:watch": "turbo run typegen && turbo run dev:watch",
    "dev:netlify": "turbo run typegen && concurrently \"turbo run --parallel\" \"netlify dev --cwd apps/web\"",
    "build": "turbo run build --force",
    "analyze": "turbo analyze",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && oxlint .",
    "lint:fix": "biome check --write . && oxlint --fix .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@hammercreative/tsconfig": "workspace:*",
    "@types/node": "^20.19.21",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.17",
    "netlify-cli": "^23.9.1",
    "oxlint": "^1.87.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
