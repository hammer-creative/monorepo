{
  "name": "@hammercreative/sanity",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "exports": {
    "./types": "./sanity.types.ts"
  },
  "scripts": {
    "clean": "rm -rf dist node_modules .sanity .turbo sanity.types.ts",
    "typegen": "npx sanity schema extract --force && npx sanity typegen generate",
    "dev:watch": "pnpm run typegen && sanity dev",
    "build": "pnpm run typegen && sanity build",
    "start": "sanity start",
    "deploy:studio": "sanity deploy",
    "deploy:graphql": "sanity graphql deploy",
    "deploy:studio:no-validation": "SANITY_STUDIO_DISABLE_REQUIRED=true sanity deploy",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && oxlint .",
    "lint:fix": "biome check --write . && oxlint --fix .",
    "format": "biome format --write ."
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/client": "^8.9.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/orderable-document-list": "^2.0.28",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/react-loader": "^2.0.0",
    "@sanity/table": "^3.1.20",
    "@sanity/ui": "^4.4.5",
    "@sanity/vision": "^6.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.19.0",
    "sanity-plugin-media": "^6.3.5",
    "sanity-plugin-mux-input": "^5.1.3",
    "sanity-plugin-taxonomy-manager": "^6.0.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@hammercreative/tsconfig": "workspace:*",
    "@hammercreative/ui": "workspace:^1.0.0",
    "@types/react": "^19.2.2",
    "@types/styled-components": "^5.1.35",
    "typescript": "^5.8"
  }
}
